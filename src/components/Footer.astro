---
import SocialLinks from "./SocialLinks.astro";
import { AUTHOR } from "../consts";
const year = new Date().getFullYear();
---
<footer class="site-footer">
	<div class="container foot-inner">
		<div class="foot-cta glass">
			<div>
				<p class="eyebrow">Get in touch</p>
				<h3>Let's build something.</h3>
				<p class="lead">Open to interesting problems in systems, local AI, and tooling.</p>
			</div>
			<a class="btn btn-primary" href={`mailto:${AUTHOR.email}`}>Say hello →</a>
		</div>
		<div class="foot-bottom">
			<span>© {year} {AUTHOR.name}</span>
			<SocialLinks />
			<span class="foot-built">Built with Astro · on Cloudflare</span>
		</div>
	</div>
</footer>
<style>
	.site-footer { border-top: 1px solid var(--line); padding-block: 3rem 2.5rem; margin-top: 2rem; }
	.foot-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		margin-bottom: 2.2rem;
	}
	.foot-cta h3 { margin: 0.2rem 0 0.3rem; }
	.foot-cta .lead { margin: 0; }
	.foot-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		color: var(--muted);
		font-size: 0.88rem;
	}
	.foot-built { font-family: var(--font-mono); font-size: 0.78rem; color: var(--faint); }
	@media (max-width: 560px) {
		.foot-bottom { justify-content: center; text-align: center; }
	}
</style>
