---
import Icon from "./Icon.astro";
import type { Project } from "../consts";
interface Props { project: Project }
const { project } = Astro.props;
const { name, subtitle, tagline, description, tags, github, live, glyph, accent, featured } = project;
const style = `--c1:${accent[0]};--c2:${accent[1]}`;
---
<article class:list={["project glass", { featured }]} style={style}>
	<div class="glow" aria-hidden="true"></div>
	<div class="project-head">
		<span class="glyph" aria-hidden="true">{glyph}</span>
		{featured && <span class="badge">Featured</span>}
	</div>

	<h3 class="project-title">
		{name}
		{subtitle && <span class="subtitle"> {subtitle}</span>}
	</h3>
	<p class="project-tagline">{tagline}</p>
	<p class="project-desc">{description}</p>

	<ul class="tags" aria-label="Tech stack">
		{tags.map((t) => <li class="tag">{t}</li>)}
	</ul>

	<div class="project-links">
		{live && (
			<a class="btn btn-primary btn-sm" href={live} target="_blank" rel="noopener noreferrer">
				Live <Icon name="external" size={15} />
			</a>
		)}
		{github && (
			<a class="btn btn-sm" href={github} target="_blank" rel="noopener noreferrer">
				<Icon name="github" size={15} /> Code
			</a>
		)}
	</div>
</article>
<style>
	.project {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: clamp(1.3rem, 3vw, 1.8rem);
		overflow: hidden;
		transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
			box-shadow 0.3s var(--ease);
	}
	.project:hover {
		transform: translateY(-5px);
		border-color: var(--line-strong);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08) inset,
			0 40px 80px -40px rgba(0, 0, 0, 0.9),
			0 0 0 1px color-mix(in srgb, var(--c1) 35%, transparent);
	}
	.glow {
		position: absolute;
		top: -40%;
		right: -30%;
		width: 60%;
		height: 80%;
		background: radial-gradient(circle, color-mix(in srgb, var(--c1) 45%, transparent), transparent 70%);
		filter: blur(40px);
		opacity: 0;
		transition: opacity 0.4s var(--ease);
		pointer-events: none;
	}
	.project:hover .glow { opacity: 0.9; }
	.project.featured { border-color: color-mix(in srgb, var(--c1) 30%, var(--line-strong)); }
	.project-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.9rem;
	}
	.glyph {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		font-size: 1.5rem;
		border-radius: 13px;
		background: linear-gradient(135deg, color-mix(in srgb, var(--c1) 28%, transparent), color-mix(in srgb, var(--c2) 22%, transparent));
		border: 1px solid var(--line);
	}
	.badge {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--c2) 82%, white);
		padding: 0.3em 0.7em;
		border-radius: 999px;
		border: 1px solid var(--line-strong); /* fallback */
		background: rgba(var(--surface), 0.06); /* fallback */
		border: 1px solid color-mix(in srgb, var(--c2) 40%, transparent);
		background: color-mix(in srgb, var(--c2) 12%, transparent);
	}
	.project-title { margin: 0 0 0.25rem; font-size: 1.35rem; }
	.subtitle { color: var(--muted); font-weight: 500; font-size: 0.95em; }
	.project-tagline {
		margin: 0 0 0.7rem;
		color: color-mix(in srgb, var(--c2) 78%, white);
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}
	.project-desc { color: var(--muted); font-size: 0.95rem; margin: 0 0 1.1rem; }
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0 0 1.3rem;
	}
	.project-links { display: flex; gap: 0.6rem; margin-top: auto; flex-wrap: wrap; }
</style>
