---
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { AUTHOR } from "../consts";
---
<header class="site-header">
	<nav class="container" aria-label="Primary">
		<a href="/" class="brand" aria-label="Home">
			<span class="brand-mark">V</span>
			<span class="brand-name">{AUTHOR.shortName}</span>
		</a>

		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<SocialLinks class="header-socials" />
	</nav>
</header>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(8, 8, 16, 0.55);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
	}
	.brand:hover { color: var(--ink); }
	.brand-mark {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 9px;
		font-size: 1rem;
		color: #08080f;
		background: var(--accent-grad);
		box-shadow: 0 6px 18px -6px rgba(124, 92, 255, 0.9);
	}
	.brand-name { font-size: 0.98rem; letter-spacing: -0.01em; }
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	@media (max-width: 760px) {
		.brand-name { display: none; }
		.header-socials { display: none; }
		.nav-links { gap: 0.1rem; font-size: 0.9rem; }
	}
	@media (max-width: 420px) {
		.nav-links :global(a) { padding-inline: 0.7rem; }
	}
</style>
