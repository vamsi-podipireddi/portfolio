---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { AUTHOR, PROJECTS, SITE_DESCRIPTION } from "../consts";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---
<Layout title={`${AUTHOR.name} — ${AUTHOR.role}`} description={SITE_DESCRIPTION}>
	<!-- Hero -->
	<section class="hero container">
		<p class="eyebrow">{AUTHOR.role}</p>
		<h1 class="hero-title">
			Hi, I'm <span class="gradient-text">{AUTHOR.name}</span>.
		</h1>
		<p class="hero-tagline">{AUTHOR.tagline}</p>
		<div class="hero-actions">
			<a class="btn btn-primary" href="#projects">View projects <Icon name="arrow" size={16} /></a>
			<a class="btn" href={AUTHOR.github} target="_blank" rel="noopener noreferrer">
				<Icon name="github" size={16} /> GitHub
			</a>
			<a class="btn" href={`mailto:${AUTHOR.email}`}><Icon name="mail" size={16} /> Email</a>
		</div>
		<div class="hero-meta">
			<span class="dot"></span> Available for interesting work · {AUTHOR.domain}
		</div>
	</section>

	<!-- Projects -->
	<section class="section container" id="projects">
		<header class="section-head">
			<div>
				<p class="eyebrow">Selected work</p>
				<h2>Projects</h2>
			</div>
			<p class="lead">Things I've built — each with source, and a live link where you can click around.</p>
		</header>
		<div class="projects-grid">
			{PROJECTS.map((p) => <ProjectCard project={p} />)}
		</div>
	</section>

	<!-- About teaser -->
	<section class="section container">
		<div class="about-card glass">
			<div class="about-body">
				<p class="eyebrow">About</p>
				<h2>A little about me</h2>
				<p class="lead">{AUTHOR.bio[0]}</p>
				<a class="btn btn-sm" href="/about">More about me <Icon name="arrowUpRight" size={15} /></a>
			</div>
			<div class="about-aside" aria-hidden="true">
				<div class="stat"><span class="num">{PROJECTS.length}</span><span class="lbl">shipped projects</span></div>
				<div class="stat"><span class="num">100%</span><span class="lbl">local-first AI</span></div>
				<div class="stat"><span class="num">∞</span><span class="lbl">curiosity</span></div>
			</div>
		</div>
	</section>

	<!-- Writing -->
	{posts.length > 0 && (
		<section class="section container" id="writing">
			<header class="section-head">
				<div>
					<p class="eyebrow">Notes</p>
					<h2>Recent writing</h2>
				</div>
				<a class="btn btn-sm" href="/blog">All posts <Icon name="arrow" size={15} /></a>
			</header>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="post-row glass">
							<div class="post-row-main">
								<h3 class="post-row-title">{post.data.title}</h3>
								<p class="post-row-desc">{post.data.description}</p>
							</div>
							<div class="post-row-meta">
								<FormattedDate date={post.data.pubDate} />
								<Icon name="arrowUpRight" size={16} />
							</div>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}
</Layout>

<style>
	/* hero */
	.hero { padding-block: clamp(4rem, 12vw, 8rem) clamp(2rem, 6vw, 4rem); max-width: 880px; }
	.hero-title { margin: 0 0 0.6rem; }
	.hero-tagline {
		font-size: clamp(1.1rem, 2.6vw, 1.5rem);
		color: var(--ink-soft);
		max-width: 40ch;
		margin: 0 0 2rem;
	}
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-bottom: 2rem; }
	.hero-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.dot {
		width: 8px; height: 8px; border-radius: 50%;
		background: #34d399;
		box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.2);
		animation: pulse 2.4s var(--ease) infinite;
	}
	@keyframes pulse { 50% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); } }

	/* section heads */
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: 2.2rem;
	}
	.section-head .lead { text-align: right; }
	.section-head h2 { margin: 0; }

	/* projects */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(1rem, 2.5vw, 1.5rem);
	}

	/* about */
	.about-card {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		padding: clamp(1.8rem, 4vw, 3rem);
		align-items: center;
	}
	.about-body h2 { margin: 0.2rem 0 0.8rem; }
	.about-body .btn { margin-top: 1.2rem; }
	.about-aside { display: grid; gap: 1.1rem; }
	.stat {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}
	.stat:last-child { border-bottom: none; padding-bottom: 0; }
	.stat .num {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--ink);
		min-width: 2.4ch;
	}
	.stat .lbl { color: var(--muted); font-size: 0.92rem; }

	/* writing list */
	.post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }
	.post-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.1rem 1.4rem;
		transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
	}
	.post-row:hover { transform: translateY(-2px); border-color: var(--line-strong); background: var(--glass-bg-hover); color: var(--ink-soft); }
	.post-row-title { margin: 0 0 0.2rem; font-size: 1.1rem; color: var(--ink); }
	.post-row-desc { margin: 0; color: var(--muted); font-size: 0.92rem; }
	.post-row-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}

	@media (max-width: 800px) {
		.projects-grid { grid-template-columns: 1fr; }
		.about-card { grid-template-columns: 1fr; }
		.section-head .lead { text-align: left; }
	}
	@media (max-width: 560px) {
		.post-row { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
		.post-row-desc { display: none; }
	}
</style>
