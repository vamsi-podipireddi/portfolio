---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { AUTHOR, PROJECTS } from "../consts";

const stack = [
	"Python", "TypeScript", "React", "FastAPI", "Bash",
	"Local LLMs (Ollama)", "PyTorch / ROCm", "Cloudflare Workers", "Astro", "Docker",
];
---
<Layout
	title={`About · ${AUTHOR.name}`}
	description="Engineer and builder focused on systems, local-first AI, and developer experience — operating-systems playgrounds, local-LLM tools, and small CLI niceties."
>
	<section class="section container about-page">
		<p class="eyebrow">About</p>
		<h1>{AUTHOR.name}</h1>
		<p class="role">{AUTHOR.role}</p>

		<div class="about-grid">
			<div class="prose-col">
				{AUTHOR.bio.map((para) => <p class="lead">{para}</p>)}

				<h2>What I work with</h2>
				<ul class="stack">
					{stack.map((s) => <li class="tag">{s}</li>)}
				</ul>

				<h2>Find me</h2>
				<div class="contact-actions">
					<a class="btn" href={AUTHOR.github} target="_blank" rel="noopener noreferrer">
						<Icon name="github" size={16} /> GitHub
					</a>
					<a class="btn" href={`mailto:${AUTHOR.email}`}><Icon name="mail" size={16} /> Email</a>
				</div>
			</div>

			<aside class="side glass">
				<h3>Highlights</h3>
				<ul class="highlights">
					{PROJECTS.map((p) => (
						<li>
							<span class="hl-glyph" aria-hidden="true">{p.glyph}</span>
							<div>
								<a href={p.live ?? p.github} target="_blank" rel="noopener noreferrer">{p.name}</a>
								<span class="hl-tag">{p.tagline}</span>
							</div>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</section>
</Layout>

<style>
	.about-page { max-width: 980px; }
	.role { font-family: var(--font-mono); color: var(--violet); margin: -0.3rem 0 2rem; }
	.about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
	.prose-col h2 { margin: 2rem 0 0.9rem; font-size: 1.4rem; }
	.stack { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
	.contact-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }
	.side { padding: 1.6rem; position: sticky; top: 84px; }
	.side h3 { margin: 0 0 1rem; font-size: 1.05rem; }
	.highlights { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
	.highlights li { display: flex; gap: 0.8rem; align-items: flex-start; }
	.hl-glyph {
		display: grid; place-items: center; flex-shrink: 0;
		width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem;
		background: var(--glass-bg); border: 1px solid var(--line);
	}
	.highlights a { color: var(--ink); font-weight: 500; display: block; }
	.highlights a:hover { color: var(--cyan); }
	.hl-tag { display: block; color: var(--muted); font-size: 0.82rem; }
	@media (max-width: 800px) {
		.about-grid { grid-template-columns: 1fr; }
		.side { position: static; }
	}
</style>
