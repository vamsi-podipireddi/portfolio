---
import Layout from "../../layouts/Layout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<Layout title="Blog · Vamsi Krishna Podipireddi" description="Notes on systems, local AI, and developer tooling.">
	<section class="section container blog-page">
		<header class="blog-head">
			<p class="eyebrow">Notes</p>
			<h1>Blog</h1>
			<p class="lead">Occasional notes on the things I build — systems, local AI, and developer tooling.</p>
		</header>

		{posts.length === 0 ? (
			<p class="lead">No posts yet. Check back soon.</p>
		) : (
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="post-card glass">
							<div class="post-card-meta">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2 class="post-card-title">{post.data.title}</h2>
							<p class="post-card-desc">{post.data.description}</p>
							<span class="read">Read <Icon name="arrow" size={15} /></span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</Layout>

<style>
	.blog-page { max-width: 920px; }
	.blog-head { margin-bottom: 2.5rem; max-width: 60ch; }
	.posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
	.post-card {
		display: block;
		padding: clamp(1.3rem, 3vw, 1.8rem);
		transition: transform 0.28s var(--ease), border-color 0.28s var(--ease), background 0.28s var(--ease);
	}
	.post-card:hover { transform: translateY(-3px); border-color: var(--line-strong); background: var(--glass-bg-hover); }
	.post-card-meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		margin-bottom: 0.6rem;
	}
	.post-card-title { margin: 0 0 0.45rem; font-size: clamp(1.3rem, 3vw, 1.7rem); color: var(--ink); }
	.post-card-desc { margin: 0 0 1rem; color: var(--muted); }
	.read {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--cyan);
		font-size: 0.9rem;
		font-weight: 500;
	}
	.post-card:hover .read { color: var(--ink); }
</style>
